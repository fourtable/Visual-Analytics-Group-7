      <aliases enabled='yes' />
      <column caption='Album type' datatype='string' name='[Album_type]' role='dimension' type='nominal' />
      <column caption='Spotify hit line' datatype='real' name='[Calculation_2526730519609344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MIN(IF [spotify_popular] THEN [Stream] END)}' />
      </column>
      <column caption='Youtube hit line' datatype='real' name='[Calculation_2526730519744513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MIN(IF [youtube_popular] THEN [Views] END)}' />
      </column>
      <column caption='Quadrant' datatype='string' name='[Calculation_2526730519851010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [spotify_popular] AND [youtube_popular] THEN &quot;Hit on both&quot; ELSEIF [spotify_popular] THEN &quot;Spotify-only hit&quot; ELSEIF [youtube_popular] THEN &quot;YouTube-only hit&quot; ELSE &quot;Neither&quot; END' />
      </column>
      <column caption='Feature value' datatype='real' name='[Calculation_2526730556112902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2526730555580421]&#13;&#10;WHEN &quot;Danceability&quot; THEN [Danceability]&#13;&#10;WHEN &quot;Energy&quot; THEN [Energy]&#13;&#10;WHEN &quot;Loudness&quot; THEN [Loudness]&#13;&#10;WHEN &quot;Valence&quot; THEN [Valence]&#13;&#10;WHEN &quot;Acousticness&quot; THEN [Acousticness]&#13;&#10;WHEN &quot;Tempo&quot; THEN [Tempo]&#13;&#10;WHEN &quot;duration_min&quot; THEN [duration_min]&#13;&#10;END' />
      </column>
      <column caption='Bin Width' datatype='real' name='[Calculation_2526730556227591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2526730555580421] WHEN &quot;Loudness&quot; THEN 1 WHEN &quot;Tempo&quot; THEN 5 WHEN &quot;duration_min&quot; THEN 0.25 ELSE 0.025 END' />
      </column>
      <column caption='Value bin' datatype='real' name='[Calculation_2526730556366856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([Calculation_2526730556112902] / [Calculation_2526730556227591]) * [Calculation_2526730556227591]' />
      </column>
      <column caption='Typical range' datatype='boolean' name='[Calculation_2526730556526601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2526730556112902] &gt;= {FIXED : PERCENTILE([Calculation_2526730556112902], 0.01)} AND [Calculation_2526730556112902] &lt;= {FIXED : PERCENTILE([Calculation_2526730556112902], 0.99)}' />
      </column>
      <column caption='Share of tier' datatype='real' name='[Calculation_2526730556616714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Uri]) / TOTAL(COUNT([Uri]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Share (smoothed)' datatype='real' name='[Calculation_2526730556702731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_2526730556616714], -1, 1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Include Song' datatype='boolean' name='[Calculation_2526730557784078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2526730557550605] = &quot;All songs&quot; OR [video_type] = &quot;Official video&quot;' />
      </column>
      <column caption='Instrumental Share' datatype='real' name='[Calculation_2526730561646612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(INT([is_instrumental]))' />
      </column>
      <column caption='Spoken-word share' datatype='real' name='[Calculation_2526730561712149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(INT([is_spoken_word]))' />
      </column>
      <column caption='Live share' datatype='real' name='[Calculation_2526730561810454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(INT([is_live]))' />
      </column>
      <column caption='z value' datatype='real' name='[Calculation_2526730563571735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2526730556112902] - {FIXED [Calculation_2526730556112902] : AVG([Calculation_2526730556112902])}) / {FIXED [Calculation_2526730556112902] : STDEV([Calculation_2526730556112902])}' />
      </column>
